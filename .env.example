# Kopieren nach .env (im Projektroot, NICHT in public/) und mit echten
# Werten fuellen. .env darf niemals committet werden.

# Kontaktformular
CONTACT_TO_EMAIL="kontakt@kuechen-klas.de"
CONTACT_FROM_EMAIL="kontaktformular@kuechenfit.de"
CONTACT_RATE_LIMIT=5
CONTACT_MIN_SUBMIT_SECONDS=3
# CONTACT_DB_PATH= (Default: storage/contact_submissions.db)
# CONTACT_VAULT_DIR= (Default: storage/contact_vault)
# CONTACT_N8N_WEBHOOK_URL=
# CONTACT_N8N_BEARER_TOKEN=

# SMTP-Versand (PHPMailer). Ohne diese Werte wird die Anfrage weiterhin
# gespeichert (SQLite + JSON-Vault), aber kein Mailversand ausgeloest.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="tls"
SMTP_FROM_EMAIL="kontakt@kuechen-klas.de"
SMTP_FROM_NAME="KüchenFit"

# Matomo Tag Manager. Default steht in config/consent.php (eigener Container
# D7C9Xhjf fuer kuechenfit.de, Basis-URL analytics.tischlermeister-klas.de in
# app/consent.php). Diese Variable nur setzen, um den Default zu ueberschreiben.
MATOMO_TAG_MANAGER_CONTAINER=""

# ProvenExpert (optional -- ohne diese Werte bleibt die Trust-Zeile im Hero
# einfach leer, kein Fehler)
PROVENEXPERT_API_ID=""
PROVENEXPERT_API_KEY=""

DEBUG_MODE="false"
